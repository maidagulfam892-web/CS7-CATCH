# CATCH Cloud API
CATCH_ENV=development
CATCH_API_HOST=0.0.0.0
CATCH_API_PORT=8000
CATCH_API_PREFIX=/api/v1
CATCH_SECRET_KEY=change-me-in-production
CATCH_ALLOWED_ORIGINS=http://localhost:19006,chrome-extension://your-extension-id
CATCH_API_KEY=dev-api-key

# Inference
CATCH_YOLO_WEIGHTS=app/ml/weights/yolov8n.pt
CATCH_YOLO_DEVICE=cpu
CATCH_MAX_UPLOAD_MB=8

# Retail scrape adapters (respect robots.txt / ToS; prefer official APIs)
CATCH_SCRAPE_USER_AGENT=CATCH-Bot/0.1 (+https://example.edu/catch)
CATCH_SCRAPE_TIMEOUT_SECONDS=12

# Firebase (server-side FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
