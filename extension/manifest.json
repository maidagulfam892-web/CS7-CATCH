{
  "manifest_version": 3,
  "name": "CATCH Try-On Everywhere",
  "version": "0.1.0",
  "description": "Scan product pages, overlay AR-ready try-on hints, and match CATCH coupons.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "action": {
    "default_title": "CATCH",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["src/content.js"],
      "css": ["src/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/overlay.css"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ]
}
